# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Official Google Cloud OAuth 2.0 Web Client ID
# Can be configured in .env or via the in-app Setup Wizard modal
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: Official Google Cloud OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ENCRYPTION_KEY: 32-character key for AES-256-GCM token storage
ENCRYPTION_KEY="youtube-ai-agent-secure-master-key-32b"
